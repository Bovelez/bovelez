// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "darwin", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  positions Position[]
}

model Position {
  id        String   @id @default(uuid())
  userId    String
  ticker    String
  quantity  Float
  buyPrice  Float
  buyDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, ticker])
}

model Price {
  ticker    String   @id
  price     Float
  fetchedAt DateTime
  updatedAt DateTime @updatedAt
}

model PriceUpdateLog {
  id          String   @id @default(uuid())
  completedAt DateTime @default(now())
  tickerCount Int
  failedCount Int      @default(0)
}

model EdgarCompany {
  id        String   @id @default(uuid())
  cik       String   @unique
  ticker    String   @unique
  name      String
  updatedAt DateTime @updatedAt
}

model StockPrice {
  ticker    String   @id
  price     Float
  updatedAt DateTime @updatedAt
}

model PriceBatchRun {
  id          String    @id @default(uuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  tickerCount Int       @default(0)
  errorCount  Int       @default(0)
  errors      Json?
}
