# Optional override for the API base URL.
# In dev, leave this empty so requests go to "/api" and are
# proxied to the NestJS backend by vite.config.ts -> server.proxy.
VITE_API_URL=/api

# Used only by the Vite dev server proxy.
# For local npm dev, use http://localhost:8080.
# For Docker Compose, the frontend service overrides this to http://dev:8080.
VITE_API_PROXY_TARGET=http://localhost:8080
