{
  "name": "front-mobile",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"appium/**/*.mjs\" \"*.{ts,js,json,css,html}\"",
    "preview": "vite preview",
    "lint": "eslint \"{src,appium}/**/*.{ts,tsx,mjs}\" --fix",
    "appium:server": "appium server --allow-insecure uiautomator2:chromedriver_autodownload",
    "test:e2e:appium": "node --test --test-concurrency=1 appium/*/*.e2e.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.16.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.17.0",
    "recharts": "2.15.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.4.2"
  }
}
